---
/**
 * Header — name (links home) and the four section links.
 * The link for the current section gets the accent colour and aria-current="page".
 */
import { NAV_LINKS, SITE } from '../data/site';

interface Props {
  /** 'landing' shows the larger name used on the home page. */
  variant?: 'landing' | 'page';
}

const { variant = 'page' } = Astro.props;

// Strip a trailing slash so "/projects/" and "/projects" compare equal.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header id="top" class:list={['site-header', variant]}>
  <div class="container inner">
    <a class="name" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          NAV_LINKS.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--space-4) var(--space-2);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .name {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--touch-min);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-name-page);
    line-height: var(--lh-tight);
    color: var(--text);
    text-decoration: none;
  }

  .landing .name {
    font-size: var(--fs-name-landing);
  }

  ul {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-move);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  nav a:focus-visible {
    color: var(--text);
  }

  @media (pointer: fine) {
    nav a:hover,
    .name:hover {
      color: var(--accent);
    }
  }

  @media (min-width: 768px) {
    .site-header {
      padding-block: var(--space-6);
    }

    .inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
    }

    .name {
      align-self: auto;
    }

    ul {
      justify-content: flex-end;
      gap: var(--space-8);
    }

    nav a {
      font-size: var(--fs-label);
    }
  }
</style>
