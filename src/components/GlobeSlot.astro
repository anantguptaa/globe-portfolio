---
/**
 * GlobeSlot — placeholder for the globe on content pages (step 5 puts the real globe here).
 * Mobile: a 250px full-width strip under the header, faded at the bottom.
 * Desktop: a square beside the page title (480px by default), fading into the content below.
 * The faint dashed circle is TEMPORARY so you can see where the globe goes.
 */
interface Props {
  /** Desktop width in px. Experience uses 480, Projects 520 (as in the mockups). */
  size?: number;
}

const { size = 480 } = Astro.props;
---

{/* The size goes in as a CSS custom property, which the desktop styles below read. */}
<div class="globe-slot" aria-hidden="true" style={`--slot-size: ${size}px`}>
  <div class="disc"></div>
</div>

<style>
  /* Mobile: full-bleed strip (cancels the container's side padding). */
  .globe-slot {
    position: relative;
    height: 250px;
    margin-inline: calc(-1 * var(--page-pad));
    overflow: hidden;
    pointer-events: none;
    /* Masks only use opacity, so any solid colour works here; var(--text) avoids a hex value. */
    -webkit-mask-image: linear-gradient(to bottom, var(--text) 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, var(--text) 60%, transparent 100%);
  }

  .disc {
    position: absolute;
    top: var(--space-2);
    left: 50%;
    width: 340px;
    aspect-ratio: 1 / 1;
    transform: translateX(-50%);
  }

  /* TEMPORARY: dashed outline where the globe's disc will be. */
  .disc::before {
    content: '';
    position: absolute;
    inset: 4%;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-round);
  }

  @media (min-width: 768px) {
    .globe-slot {
      flex: 0 1 var(--slot-size);
      width: min(var(--slot-size), 86vw);
      height: auto;
      aspect-ratio: 1 / 1;
      margin-inline: auto;
      overflow: visible;
      -webkit-mask-image: linear-gradient(to bottom, var(--text) 45%, transparent 92%);
      mask-image: linear-gradient(to bottom, var(--text) 45%, transparent 92%);
    }

    .disc {
      top: 0;
      left: 0;
      width: 100%;
      transform: none;
    }
  }
</style>
