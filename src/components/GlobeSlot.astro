---
/**
 * GlobeSlot — where the globe sits on this page, and what it points at.
 *
 * The live globe isn't inside this box: it lives once in BaseLayout (so it survives page
 * changes) and is moved over this slot by src/globe/site-globe.ts. The slot provides:
 *  - the place and size, through ordinary CSS below (so layout stays in one place);
 *  - the still image, shown straight away and whenever there's no live globe;
 *  - the page's pins and active pin, as data attributes the globe reads;
 *  - the area you can drag to turn the globe.
 *
 * Placement:
 *  - sticky  inner pages, placed by GlobePage.astro, so the globe stays on screen while scrolling.
 *            Below 1100px: a full-width 250px strip at the top of the page. It sticks with only
 *            its bottom 140px on screen, so it "shrinks" as the page scrolls, and the content
 *            passes under its faded bottom edge. 1100px and wider: a square (size px, or less on
 *            short screens) in the right-hand column, sticking near the top of the screen.
 *  - page    the 404 page: the strip under the header below 1100px; beside the text from
 *            1100px, fading into the content. It scrolls with the page.
 *  - landing large, behind the menu: below the header on mobile, off the right edge on desktop.
 * The live globe's window copies this box's position (sticky or not), fade, clipping and
 * background from its computed CSS, so the placement is only ever written here.
 */
import type { PagePins } from '../lib/pins';

export type StillName = 'landing' | 'about' | 'projects' | 'experience' | 'contact' | '404';

interface Props extends PagePins {
  /** Which pre-rendered still to show (public/globe/still-<name>.webp). */
  still: StillName;
  variant?: 'sticky' | 'page' | 'landing';
  /** Desktop width in px (sticky and page variants). Experience 480, Projects 520, as in the mockups. */
  size?: number;
}

const { pins, active, still, variant = 'page', size = 480 } = Astro.props;
const activePin = pins.find((p) => p.id === active);
const alt = activePin ? `Dotted globe pinned at ${activePin.label}` : 'Dotted globe of the Earth';
---

{/* The size goes in as a CSS custom property, which the desktop styles below read. */}
<div
  class:list={['globe-slot', variant]}
  style={`--slot-size: ${size}px`}
  data-globe-slot
  data-pins={JSON.stringify(pins)}
  data-active={active}
>
  {/* The disc: the square the globe is drawn in. The live globe's canvas is placed exactly here. */}
  <div class="disc" data-globe-disc>
    {
      /* The still is each page's largest image (its LCP element on phones), so the browser is
         told to fetch it early and at high priority, ahead of fonts and scripts. */
    }
    <img
      class="globe-still"
      src={`/globe/still-${still}.webp`}
      alt={alt}
      fetchpriority="high"
      loading="eager"
      decoding="async"
      draggable="false"
    />
    {/* Optional overlay drawn over the globe, in the disc's box (e.g. Contact's signal arc). */}
    <slot />
  </div>
</div>

<style>
  /* ---------- Page: mobile strip (default) ---------- */
  .globe-slot {
    position: relative;
    height: 250px;
    margin-inline: calc(-1 * var(--page-pad)); /* full bleed: cancels the container's padding */
    overflow: hidden;
    /* Masks only use opacity, so any solid colour works here; var(--text) avoids a hex value. */
    -webkit-mask-image: linear-gradient(to bottom, var(--text) 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, var(--text) 60%, transparent 100%);
  }

  .disc {
    position: absolute;
    top: var(--space-2);
    left: 50%;
    width: 340px;
    aspect-ratio: 1 / 1;
    transform: translateX(-50%);
  }

  /* The still fills the disc. Stills are square screenshots of the live globe at the same
     framing, so the live globe lands exactly on top. */
  .globe-still {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    transition: opacity var(--dur-base) var(--ease-settle);
  }

  /* Live globe ready (set by site-globe.ts on <html>): the still fades out as the globe
     fades in. On later pages it is simply never shown. */
  :global(html[data-globe='live']) .globe-still {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-still {
      transition-duration: var(--dur-fast);
    }
  }

  /* ---------- Page: beside the title, 1100px and wider ---------- */
  @media (min-width: 1100px) {
    .globe-slot.page {
      flex: 0 1 var(--slot-size);
      width: min(var(--slot-size), 86vw);
      height: auto;
      aspect-ratio: 1 / 1;
      margin-inline: auto;
      overflow: visible;
      -webkit-mask-image: linear-gradient(to bottom, var(--text) 45%, transparent 92%);
      mask-image: linear-gradient(to bottom, var(--text) 45%, transparent 92%);
    }

    .page .disc {
      top: 0;
      left: 0;
      width: 100%;
      transform: none;
    }
  }

  /* ---------- Sticky (inner pages, inside GlobePage) ---------- */
  /* Below 1100px: the strip. It's 250px tall in the page, but sticks at a negative top, so
     once it reaches the top of the screen only its bottom 140px stays visible. The strip
     "shrinks" by scrolling up those 110px with the page, then stays: no animation, so it
     moves exactly with the content and can't stutter. Its background hides the content
     passing under it, and the mask fades its bottom edge. It must be the first thing in its
     container with no top margin: site-globe.ts relies on that to mirror it. */
  .globe-slot.sticky {
    position: sticky;
    top: calc(var(--strip-compact) - var(--strip-h));
    z-index: 2;
    height: var(--strip-h);
    margin-inline: calc(-1 * var(--page-pad)); /* full bleed */
    overflow: hidden;
    background-color: var(--bg);
    -webkit-mask-image: linear-gradient(to bottom, var(--text) calc(100% - var(--strip-fade)), transparent 100%);
    mask-image: linear-gradient(to bottom, var(--text) calc(100% - var(--strip-fade)), transparent 100%);
  }

  /* 1100px and wider: a square in the globe column, sticking near the top of the screen.
     It's never taller than the screen, so the whole globe stays in view. */
  @media (min-width: 1100px) {
    .globe-slot.sticky {
      top: var(--globe-sticky-top);
      align-self: start;
      justify-self: center;
      width: min(var(--slot-size), 100%, calc(100svh - 2 * var(--globe-sticky-top)));
      height: auto;
      aspect-ratio: 1 / 1;
      margin-inline: 0;
      overflow: visible;
      background-color: transparent;
      -webkit-mask-image: linear-gradient(to bottom, var(--text) 45%, transparent 92%);
      mask-image: linear-gradient(to bottom, var(--text) 45%, transparent 92%);
    }

    .sticky .disc {
      top: 0;
      left: 0;
      width: 100%;
      transform: none;
    }
  }

  /* ---------- Landing ---------- */
  /* Placed absolutely inside BaseLayout's landing clip box; no fade. */
  .globe-slot.landing {
    position: absolute;
    left: 5vw;
    top: 150px;
    width: 90vw;
    height: auto;
    aspect-ratio: 1 / 1;
    margin: 0;
    overflow: visible;
    -webkit-mask-image: none;
    mask-image: none;
    pointer-events: auto; /* draggable where the menu rows don't cover it */
  }

  .landing .disc {
    top: 0;
    left: 0;
    width: 100%;
    transform: none;
  }

  @media (min-width: 768px) {
    .globe-slot.landing {
      left: auto;
      right: -4vw;
      top: 70px;
      width: min(780px, 70vw);
    }
  }
</style>
