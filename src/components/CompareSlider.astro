---
/**
 * CompareSlider — satellite tile vs predicted mask.
 * PLACEHOLDER: for now it shows the tile with both labels, at the mockup's size
 * (2:1 on desktop, 4:3 on mobile). Only rendered when a project has `compare` images.
 * TODO (step 8): stack the mask over the tile, clip it at a split, and drive the split with a
 * real <input type="range"> and its label ("Drag to compare").
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  /** Project title, used in the alt text. */
  title: string;
}

const { before, title } = Astro.props;
---

<section class="compare" aria-labelledby="compare-heading">
  <h2 class="section-label" id="compare-heading">Image <span aria-hidden="true">→</span><span class="visually-hidden">and</span> prediction</h2>
  <div class="frame">
    <Image
      src={before}
      alt={`${title}: aerial image tile`}
      widths={[600, 1100]}
      sizes="(min-width: 1200px) 1100px, 90vw"
    />
    <span class="tag tag-left" aria-hidden="true">Satellite</span>
    <span class="tag tag-right" aria-hidden="true">Predicted fields</span>
  </div>
</section>

<style>
  .compare {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tag {
    position: absolute;
    top: var(--space-4);
    padding: var(--space-1) var(--space-2);
    background-color: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .tag-left {
    left: var(--space-4);
  }
  .tag-right {
    right: var(--space-4);
  }

  @media (min-width: 768px) {
    .frame {
      aspect-ratio: 2 / 1;
    }
  }
</style>
