---
/**
 * SocialIcon — 44px round link with an inline SVG icon.
 * Hover (fine pointers) or keyboard focus: blue fills up from the bottom,
 * the icon flips once around its Y axis and turns the background colour.
 */
import type { SocialKind } from '../data/site';

interface Props {
  kind: SocialKind;
  href: string;
  label: string;
}

const { kind, href, label } = Astro.props;
---

<a class="social-icon" href={href} aria-label={label}>
  <span class="glyph" aria-hidden="true">
    {
      kind === 'email' && (
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3.5 6 8.5 7 8.5-7" />
        </svg>
      )
    }
    {
      kind === 'github' && (
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      )
    }
    {
      kind === 'linkedin' && (
        <svg viewBox="2 2 20 20" width="16" height="16" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.064 2.064 0 1 1 0-4.128 2.064 2.064 0 0 1 0 4.128zm1.782 13.019H3.555V9h3.564v11.452z" />
        </svg>
      )
    }
    {
      kind === 'cv' && (
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
          <path d="M14 3v5h5M9 13h6M9 17h6" />
        </svg>
      )
    }
  </span>
</a>

<style>
  .social-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--touch-min);
    height: var(--touch-min);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-round);
    color: var(--text);
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-move);
  }

  /* Blue fill that rises from the bottom */
  .social-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--dur-base) var(--ease-move);
  }

  .glyph {
    display: grid;
    place-items: center;
    transition:
      transform var(--dur-spin) var(--ease-move),
      color var(--dur-fast) var(--ease-move);
  }

  /* Active state: keyboard focus everywhere, hover only on fine pointers,
     and :active as the tap state on touch screens. */
  .social-icon:focus-visible,
  .social-icon:active {
    border-color: var(--accent);
  }
  .social-icon:focus-visible::before,
  .social-icon:active::before {
    transform: scaleY(1);
  }
  .social-icon:focus-visible .glyph,
  .social-icon:active .glyph {
    color: var(--bg);
    transform: rotateY(360deg);
  }

  @media (pointer: fine) {
    .social-icon:hover {
      border-color: var(--accent);
    }
    .social-icon:hover::before {
      transform: scaleY(1);
    }
    .social-icon:hover .glyph {
      color: var(--bg);
      transform: rotateY(360deg);
    }
  }

  /* Reduced motion: colour change only — no rising fill, no spin. */
  @media (prefers-reduced-motion: reduce) {
    .social-icon,
    .social-icon::before,
    .glyph {
      transition-property: opacity, color, border-color;
      transition-duration: var(--dur-fast);
    }
    .social-icon::before {
      transform: none;
      opacity: 0;
    }
    .social-icon:focus-visible::before,
    .social-icon:active::before {
      opacity: 1;
    }
    .social-icon:focus-visible .glyph,
    .social-icon:active .glyph {
      transform: none;
    }
    @media (pointer: fine) {
      .social-icon:hover::before {
        opacity: 1;
      }
      .social-icon:hover .glyph {
        transform: none;
      }
    }
  }
</style>
