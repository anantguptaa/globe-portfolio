---
/**
 * StatGrid — a project's key numbers: big value, mono label underneath.
 * Desktop: one row, one column per stat (1–4). Mobile: 2 × 2.
 * Marked up as a description list, so a screen reader hears "test mIoU: 0.896".
 * The label (<dt>) comes first in the HTML, as <dl> requires; CSS shows the number on top.
 */
interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

<dl class="stat-grid" aria-label="Key numbers" style={`--cols: ${stats.length}`}>
  {
    stats.map(({ value, label }) => (
      <div class="stat">
        <dt class="label">{label}</dt>
        <dd class="value">{value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
    border-block: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse; /* number above its label */
    justify-content: flex-end;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  .value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-stat);
    line-height: var(--lh-tight);
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .stat-grid {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .stat {
      padding-block: var(--space-8);
    }

    .label {
      font-size: var(--fs-label);
    }
  }
</style>
