---
/**
 * /experience — the "flight log": every role from src/content/roles, newest first, education last.
 * Everything in this frontmatter runs at build time; the browser only gets the finished HTML.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobePage from '../components/GlobePage.astro';
import RoleEntry from '../components/RoleEntry.astro';
import { PAGE_DESCRIPTIONS, SITE } from '../data/site';
import { formatCoords } from '../lib/geo';
import { experiencePins, experienceRole } from '../lib/pins';
import { sortRoles } from '../lib/roles';

// 1. Read every role file. Each entry has an id (the filename) and typed data (the frontmatter).
const roles = sortRoles(await getCollection('roles'));

// 2. For roles that reference a project, look the project up to get its title and URL.
const entries = await Promise.all(
  roles.map(async (role) => {
    const ref = role.data.project;
    const project = ref ? await getEntry(ref) : undefined;
    return {
      role,
      project: project ? { title: project.data.title, href: `/projects/${project.id}` } : undefined,
    };
  }),
);

// The page's pin: the newest role that isn't remote (or education), worked out from the
// role files, so it moves by itself when a new on-site role is added. Shown in the readout.
const first = experienceRole(roles);
const pageCoords = formatCoords(first.data.location.lat, first.data.location.lon);
// The globe: one pin per role's place, with that role's place active. `roleTargets` gives
// each role its pin (two roles in the same city share one).
const { targets: roleTargets, ...globe } = await experiencePins();
---

<BaseLayout title="Experience" description={PAGE_DESCRIPTIONS.experience} coords={pageCoords}>
  <GlobePage still="experience" {...globe}>
    <div class="page">
      <section class="hero">
        <div class="intro">
          <p class="eyebrow">Flight log</p>
          <h1>Experience</h1>
          <p class="lede lede-desktop">Hover a role to see where it happened.</p>
          <p class="lede lede-mobile">Tap a role to see where it happened and what I did.</p>
          {
            first && (
              // Follows the role the globe points at (src/globe/interactions.ts). Not a live
              // region: the globe already announces its active pin to screen readers.
              // Visually hidden once the live globe's label shows the same place.
              <div class="readout readout-when-no-globe" data-globe-readout>
                <span class="readout-coords" data-readout-coords>
                  {formatCoords(first.data.location.lat, first.data.location.lon)}
                </span>
                <span class="readout-place" data-readout-place>
                  {first.data.title} · {first.data.location.label}
                </span>
              </div>
            )
          }
        </div>
      </section>

      <div class="roles">
        {
          entries.map(({ role, project }) => (
            <RoleEntry role={role} project={project} globeTarget={roleTargets[role.id] ?? role.id} />
          ))
        }
      </div>

      <a class="cv-button" href={SITE.cvHref} target="_blank" rel="noopener">
        Full CV (PDF) <span aria-hidden="true">↗</span>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </div>
  </GlobePage>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-16);
  }

  /* ---------- Top section ---------- */
  .hero {
    display: flex;
    flex-direction: column;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-2) var(--space-6);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .lede {
    max-width: 460px;
    color: var(--text-muted);
  }

  .lede-desktop,
  .readout {
    display: none;
  }

  .readout {
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .readout-coords {
    font-size: var(--fs-body-sm);
    color: var(--accent);
  }

  .readout-place {
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  /* ---------- Roles ---------- */
  .roles {
    border-bottom: 1px solid var(--border);
  }

  /* ---------- CV button ---------- */
  .cv-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: var(--touch-min);
    margin-top: var(--space-8);
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-button);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-move),
      color var(--dur-fast) var(--ease-move);
  }

  .cv-button:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (pointer: fine) {
    .cv-button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 768px) {
    .lede {
      font-size: var(--fs-body);
    }

    .lede-desktop {
      display: block;
    }
    .lede-mobile {
      display: none;
    }
    .readout {
      display: flex;
    }

    .cv-button {
      align-self: flex-start;
      margin-top: var(--space-12);
    }
  }

  /* ---------- Beside the globe (1100px and wider) ---------- */
  @media (min-width: 1100px) {
    .intro {
      padding-block: var(--space-16) var(--space-10);
    }
  }
</style>
