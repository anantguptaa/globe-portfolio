---
/**
 * /dev/globe — TEMPORARY test page for the globe (step 5). Not linked from anywhere, and
 * deleted once step 5 is finished. It doesn't use BaseLayout: just the globe and some controls.
 *
 * 5b: a button for every pin the site uses (each flies the globe there and makes that pin
 * active), and a tall page so scrolling shows the scroll spin. The globe can also be dragged
 * (built into Globe.ts); after a few seconds it flies back to the active pin.
 */
import '@fontsource/jetbrains-mono/latin-400.css';
import '../../styles/global.css';
import { formatCoords } from '../../lib/geo';

// Every pin the real pages will use.
const places = [
  { id: 'about', button: 'About', label: 'North Pole', lat: 90, lon: 0 },
  { id: 'projects', button: 'Projects', label: 'USA', lat: 41.88, lon: -93.1 },
  { id: 'experience', button: 'Experience', label: 'Edmonton', lat: 53.52, lon: -113.53 },
  { id: 'contact', button: 'Contact', label: 'Point Nemo', lat: -48.88, lon: -123.39 },
  { id: 'noida', button: 'Noida', label: 'Noida, India', lat: 28.54, lon: 77.39 },
  { id: 'delhi', button: 'Delhi', label: 'Delhi, India', lat: 28.61, lon: 77.21 },
  { id: 'dijon', button: 'Dijon', label: 'ACDC cardiac MRI, Dijon', lat: 47.32, lon: 5.04 },
];

// The shape Globe.setPins() expects. Coordinates are formatted here, at build time.
const pins = places.map(({ id, label, lat, lon }) => ({ id, lat, lon, label, coords: formatCoords(lat, lon) }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Keep search engines away from this page while it exists. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>Globe test</title>
  </head>
  <body>
    <main class="test">
      <h1 class="visually-hidden">Globe test page</h1>

      {/* Stays at the top while the page scrolls, so the scroll spin is easy to watch. */}
      <div class="sticky">
        {/* data-pins hands the list above to the script below as JSON. */}
        <div class="stage" id="globe-stage" data-pins={JSON.stringify(pins)}></div>

        <div class="panel">
          <p class="readout" id="globe-readout">Loading…</p>
          <div class="buttons">
            {
              places.map((place) => (
                <button type="button" data-pin={place.id} aria-pressed="false">
                  {place.button}
                </button>
              ))
            }
          </div>
          <p class="hint">Scroll to spin · drag the globe to turn it</p>
        </div>
      </div>

      {/* TEMPORARY: empty height, only so the page can scroll. */}
      <div class="scroll-room" aria-hidden="true">
        <p>Scroll spin test area</p>
        <p>0.25° of longitude per pixel</p>
        <p>End</p>
      </div>
    </main>

    <script>
      // A normal bundled script: Astro compiles this TypeScript and pulls in Three.js for
      // this page only. (5c will load it later, after the page's text has painted.)
      import { Globe, type GlobePin } from '../../globe/Globe';

      const stage = document.getElementById('globe-stage') as HTMLElement;
      const readout = document.getElementById('globe-readout') as HTMLElement;
      const pinButtons = document.querySelectorAll<HTMLButtonElement>('button[data-pin]');

      const format = (lat: number, lon: number) =>
        `${Math.abs(lat).toFixed(2)}°${lat < 0 ? 'S' : 'N'} ${Math.abs(lon).toFixed(2)}°${lon < 0 ? 'W' : 'E'}`;

      try {
        let settled = true;
        const show = () => {
          const { lat, lon } = globe.center;
          readout.textContent = `${settled ? 'Settled' : 'Moving'} · centre ${format(lat, lon)}`;
        };

        const globe = new Globe(stage, {
          label: 'Dotted globe of the Earth with a pin for each place on this site',
          onSettle: (isSettled) => {
            settled = isSettled;
            show();
            if (!isSettled) requestAnimationFrame(follow);
          },
        });

        // TEMPORARY: while the globe moves, refresh the readout every frame.
        const follow = () => {
          show();
          if (!settled) requestAnimationFrame(follow);
        };

        const pins: GlobePin[] = JSON.parse(stage.dataset.pins ?? '[]');
        globe.setPins(pins);

        // Pin buttons: make that pin active and fly to it.
        const select = (id: string) => {
          const pin = pins.find((p) => p.id === id);
          if (!pin) return;
          pinButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pin === id)));
          globe.setActive(id);
          globe.flyTo(pin.lat, pin.lon);
          show();
        };
        pinButtons.forEach((button) => button.addEventListener('click', () => select(button.dataset.pin ?? '')));

        // Start on the Experience pin, without the flight.
        const first = pins.find((p) => p.id === 'experience') ?? pins[0];
        if (first) {
          globe.setActive(first.id);
          globe.lookAt(first.lat, first.lon);
          pinButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pin === first.id)));
        }
        show();
      } catch (error) {
        // No WebGL: say so. (5c shows the still image here instead.)
        readout.textContent = 'This browser could not start WebGL, so the globe cannot be shown.';
        console.error(error);
      }
    </script>
  </body>
</html>

<style>
  .test {
    padding-inline: var(--page-pad);
  }

  .sticky {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
    background-color: var(--bg); /* so the scrolling text passes behind, not over, the globe */
    z-index: 1;
  }

  /* The globe fills this box; resize the window to test the ResizeObserver. */
  .stage {
    width: min(100%, 62dvh, 780px);
    aspect-ratio: 1 / 1;
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
  }

  .readout {
    color: var(--accent);
  }

  .hint {
    color: var(--text-muted);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  button {
    min-height: var(--touch-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-button);
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-move),
      color var(--dur-fast) var(--ease-move);
  }

  button:focus-visible,
  button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (pointer: fine) {
    button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .scroll-room {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    height: 300dvh;
    padding-block: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
