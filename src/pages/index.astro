---
/**
 * Landing page (/): name and tagline in the header, four full-width menu rows, footer.
 * The globe placeholder sits behind it (added by BaseLayout for variant="landing").
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuRow from '../components/MenuRow.astro';
import { NAV_LINKS } from '../data/site';

// Globe pin each row will aim at (used from step 6).
const pins: Record<string, string> = {
  '/about': 'about',
  '/projects': 'projects',
  '/experience': 'experience',
  '/contact': 'contact',
};
---

<BaseLayout variant="landing">
  <nav class="menu" aria-label="Main">
    <ul>
      {
        /* One MenuRow per nav link. Each prop is set like an HTML attribute;
           {expressions} pass any JavaScript value, such as the number i + 1. */
        NAV_LINKS.map(({ href, label }, i) => (
          <li>
            <MenuRow href={href} index={i + 1} label={label} pin={pins[href]} />
          </li>
        ))
      }
    </ul>
    <!-- TODO (step 6): true once the globe exists; until then a tap opens the page straight away. -->
    <p class="hint label">Tap once to aim · Tap again to open</p>
  </nav>
</BaseLayout>

<style>
  /* Fills the space between header and footer; rows centred vertically on every screen size. */
  .menu {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  /* Mobile only: closes the list with a hairline and explains tap-to-aim. */
  .hint {
    padding: var(--space-3) var(--gutter-full);
    border-block: 1px solid var(--border);
    font-size: var(--fs-label-sm);
    letter-spacing: var(--tracking-label-wide);
  }

  @media (min-width: 768px) {
    .hint {
      display: none;
    }
  }
</style>
