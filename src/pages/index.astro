---
/**
 * Landing page (/): name and tagline in the header, four full-width menu rows, footer.
 * The globe sits behind it (BaseLayout places the landing GlobeSlot from the `globe` prop).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuRow from '../components/MenuRow.astro';
import { NAV_LINKS } from '../data/site';
import { landingPins } from '../lib/pins';

// The globe's four menu pins (from the content files) and the active one (About).
const globe = await landingPins();

// Globe pin each row aims at; these ids match the pin ids above (and the still images).
const pins: Record<string, string> = {
  '/about': 'about',
  '/projects': 'projects',
  '/experience': 'experience',
  '/contact': 'contact',
};
---

<BaseLayout variant="landing" globe={globe}>
  <nav class="menu" aria-label="Main">
    <ul>
      {
        /* One MenuRow per nav link. Each prop is set like an HTML attribute;
           {expressions} pass any JavaScript value, such as the number i + 1. */
        NAV_LINKS.map(({ href, label }, i) => (
          <li>
            <MenuRow href={href} index={i + 1} label={label} pin={pins[href]} />
          </li>
        ))
      }
    </ul>
    {/* Only shown with JavaScript: without it a tap simply opens the page. */}
    <p class="hint label">Tap once to aim · Tap again to open</p>
  </nav>
</BaseLayout>

<style>
  /* Fills the space between header and footer; rows centred vertically on every screen size. */
  .menu {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  /* Mobile only, and only with JavaScript: closes the list with a hairline and explains
     tap-to-aim (src/globe/interactions.ts). */
  .hint {
    display: none;
  }

  :global(.js) .hint {
    display: block;
    padding: var(--space-3) var(--gutter-full);
    border-block: 1px solid var(--border);
    font-size: var(--fs-label-sm);
    letter-spacing: var(--tracking-label-wide);
  }

  @media (min-width: 768px) {
    :global(.js) .hint {
      display: none;
    }
  }
</style>
