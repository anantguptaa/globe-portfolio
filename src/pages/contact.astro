---
/**
 * /contact — "ground station": headline, status line and one row per channel.
 * The intro text lives in src/content/pages/contact.md; the links come from SOCIAL_LINKS
 * (the same list the footer icons use), so each link is written down only once.
 * The footer hides its icons here: these rows already link to every channel.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobePage from '../components/GlobePage.astro';
import { contactPins } from '../lib/pins';
import { SOCIAL_LINKS, linkDisplay } from '../data/site';
import { formatCoords } from '../lib/geo';

const contact = await getEntry('pages', 'contact');
if (!contact) throw new Error('Missing src/content/pages/contact.md');

const { location, description } = contact.data;
const { Content } = await render(contact);
const coords = formatCoords(location.lat, location.lon);
// The globe's pin: contact.md's location (Point Nemo).
const globe = await contactPins();
---

<BaseLayout title="Contact" description={description} coords={coords} showSocial={false}>
  <GlobePage still="contact" {...globe}>
    {
      /* The signal arc: an SVG laid over the globe, in the globe disc's box (0–100 both
         ways). Cheaper than drawing on the globe: the browser animates one path, and the
         globe's render loop isn't involved. Decorative, so hidden from screen readers. */
    }
    <svg slot="overlay" class="signal" viewBox="0 0 100 100" aria-hidden="true" focusable="false" data-signal-arc>
      <path pathLength="1" data-signal-path></path>
    </svg>
    <div class="page">
      <section class="hero">
        <div class="intro">
          <p class="eyebrow">
            Ground station<span class="eyebrow-coords"><span aria-hidden="true"> · </span>{coords}</span><span
              aria-hidden="true"> · </span>{location.label}
          </p>
          <h1>Contact</h1>
          <div class="lede">
            <Content />
          </div>
          {
            /* While a channel row is hovered or focused, the dot turns blue and the text reads
               "Transmitting · <channel>"; on desktop a signal arc leaves the pin (script below). */
          }
          <p class="status" data-signal-status>
            <span class="dot" aria-hidden="true"></span>
            <span data-signal-text>Channel open · Standing by</span>
          </p>
        </div>
      </section>

      <ul class="channels" aria-label="Contact channels">
        {
          SOCIAL_LINKS.map((link, i) => {
            const newTab = link.kind === 'cv';
            return (
              <li>
                <a
                  class="channel"
                  href={link.href}
                  data-channel={link.kind}
                  data-signal-index={i}
                  data-signal-label={link.label}
                  {...(newTab ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <span class="channel-name">
                    CH {String(i + 1).padStart(2, '0')} · {link.label}
                  </span>
                  <span class="channel-value">
                    {/* &nbsp; keeps the arrow on the same line as the end of the address. */}
                    {linkDisplay(link)}&nbsp;<span aria-hidden="true">↗</span>
                    {newTab && <span class="visually-hidden">(opens in a new tab)</span>}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </GlobePage>
</BaseLayout>

<script>
  // Bundled, so it runs once per visit. Listeners are on `document` (it survives page changes),
  // so they're never added twice; on other pages there are simply no channel rows.
  import { getSiteGlobe } from '../globe/site-globe';

  const fine = window.matchMedia('(pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  /** Arc direction for each channel row, in degrees (0 = right, negative = up): a fan. */
  const ANGLES = [-100, -55, -15, 25];
  /** One arc: drawn over the first part, faded over the next, then a pause before the next. */
  const CYCLE = 1200; // ms
  const DRAW_END = 0.42; // ≈0.5s of drawing
  const FADE_END = 0.67; // ≈0.3s of fading

  let activeRow: HTMLElement | null = null;
  let arc: Animation | null = null;
  // After a page change the mouse may already sit where a row now is, and the browser reports
  // a hover there without the mouse moving. So the first position seen after a page change is
  // a reference point, and hover counts only once the mouse has moved away from it.
  let hoverArmed = true;
  let refX: number | null = null;
  let refY: number | null = null;

  /** False while the mouse hasn't moved since the page changed. */
  function moved(event: PointerEvent): boolean {
    if (hoverArmed) return true;
    if (refX === null || refY === null) {
      refX = event.clientX;
      refY = event.clientY;
      return false;
    }
    if (Math.hypot(event.clientX - refX, event.clientY - refY) <= 2) return false;
    hoverArmed = true;
    return true;
  }

  const rowOf = (node: EventTarget | null) =>
    node instanceof Element ? node.closest<HTMLElement>('.channel[data-signal-index]') : null;

  function setStatus(row: HTMLElement | null): void {
    const status = document.querySelector<HTMLElement>('[data-signal-status]');
    const text = status?.querySelector('[data-signal-text]');
    if (!status || !text) return;
    status.toggleAttribute('data-transmitting', !!row);
    text.textContent = row ? `Transmitting · ${row.dataset.signalLabel}` : 'Channel open · Standing by';
  }

  /** Where the pin is, in the disc's 0–100 box: the live globe's real pin, or the centre. */
  function pinPoint(disc: HTMLElement): { x: number; y: number } {
    const globe = document.documentElement.dataset.globe === 'live' ? getSiteGlobe() : null;
    const id = disc.closest<HTMLElement>('[data-globe-slot]')?.dataset.active ?? '';
    const p = globe?.pinScreenPoint(id);
    const size = disc.clientWidth;
    return p && size ? { x: (p.x / size) * 100, y: (p.y / size) * 100 } : { x: 50, y: 50 };
  }

  /** Send one arc for the active row; when it's done, send the next while the row stays active. */
  function sendArc(row: HTMLElement): void {
    const svg = document.querySelector<SVGSVGElement>('[data-signal-arc]');
    const path = svg?.querySelector<SVGPathElement>('[data-signal-path]');
    const disc = svg?.parentElement;
    if (!svg || !path || !disc) return;

    // From the pin, curving outward to just past the globe's edge in this channel's direction.
    const start = pinPoint(disc);
    const angle = (ANGLES[Number(row.dataset.signalIndex) % ANGLES.length] ?? 0) * (Math.PI / 180);
    const end = { x: 50 + 50 * Math.cos(angle), y: 50 + 50 * Math.sin(angle) };
    const dx = end.x - start.x;
    const dy = end.y - start.y;
    const length = Math.hypot(dx, dy) || 1;
    const bend = 0.22 * length; // sideways pull of the curve
    const control = { x: (start.x + end.x) / 2 - (dy / length) * bend, y: (start.y + end.y) / 2 + (dx / length) * bend };
    path.setAttribute('d', `M ${start.x} ${start.y} Q ${control.x} ${control.y} ${end.x} ${end.y}`);

    const ease = getComputedStyle(document.documentElement).getPropertyValue('--ease-move').trim() || 'ease';
    arc = path.animate(
      [
        { strokeDashoffset: 1, opacity: 1, offset: 0, easing: ease },
        { strokeDashoffset: 0, opacity: 1, offset: DRAW_END },
        { strokeDashoffset: 0, opacity: 0, offset: FADE_END },
        { strokeDashoffset: 0, opacity: 0, offset: 1 },
      ],
      { duration: CYCLE },
    );
    arc.onfinish = () => {
      if (activeRow === row) sendArc(row); // still transmitting: next arc, from the pin's current spot
    };
  }

  function start(row: HTMLElement): void {
    if (row === activeRow) return;
    arc?.cancel();
    activeRow = row;
    setStatus(row);
    if (fine.matches && !reduce.matches) sendArc(row); // desktop only; reduced motion: no arc
  }

  function stop(): void {
    if (!activeRow) return;
    activeRow = null;
    setStatus(null);
    arc?.cancel(); // the path's resting style is invisible
    arc = null;
  }

  // The first real move after a page change also starts a row the mouse is already on.
  document.addEventListener('pointermove', (event) => {
    if (event.pointerType !== 'mouse' || hoverArmed) return;
    if (moved(event)) {
      const row = rowOf(event.target);
      if (row) start(row);
    }
  });

  document.addEventListener('pointerover', (event) => {
    if (event.pointerType === 'mouse' && !moved(event)) return; // content moved under a still mouse
    const row = rowOf(event.target);
    if (row) start(row);
    else if (activeRow && !rowOf(document.activeElement)) stop(); // left the rows (and none has focus)
  });
  document.addEventListener('focusin', (event) => {
    const row = rowOf(event.target);
    if (row) start(row);
  });
  document.addEventListener('focusout', (event) => {
    if (!rowOf(event.relatedTarget)) stop();
  });
  // A new page: forget the old rows, and ignore hovers until the mouse moves.
  document.addEventListener('astro:page-load', () => {
    activeRow = null;
    arc = null;
    hoverArmed = false;
    refX = null;
    refY = null;
  });
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-16);
  }

  /* ---------- Top section (same pattern as the other pages) ---------- */
  .hero {
    display: flex;
    flex-direction: column;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-2) var(--space-6);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  /* The mobile mockup shows just "Ground station · Point Nemo". */
  .eyebrow-coords {
    display: none;
  }

  .lede {
    max-width: 480px;
    color: var(--text-muted);
  }

  .status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-round);
    background-color: var(--ok);
    transition: background-color var(--dur-fast) var(--ease-move);
  }

  /* A channel row is hovered or focused: transmitting. */
  .status {
    transition: color var(--dur-fast) var(--ease-move);
  }

  .status[data-transmitting] {
    color: var(--accent);
  }

  .status[data-transmitting] .dot {
    background-color: var(--accent);
  }

  /* ---------- Signal arc (over the globe) ---------- */
  .signal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  /* Drawn by the script: the dash offset goes 1 → 0 (the line grows), then it fades. */
  /* stroke-width is in the SVG's 0–100 units (about 2px on a 480px globe). pathLength="1"
     makes the dash maths simple: one dash as long as the whole path. */
  .signal path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.45;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  /* ---------- Channel rows ---------- */
  .channels {
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
  }

  /* Mobile: channel name above the address. The whole row is one link. */
  .channel {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: var(--touch-min);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }

  .channel-name {
    font-size: var(--fs-label-sm);
    letter-spacing: var(--tracking-label-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .channel-value {
    font-size: var(--fs-body);
    overflow-wrap: anywhere; /* long addresses never push the page sideways */
    transition: color var(--dur-fast) var(--ease-move);
  }

  .channel:focus-visible .channel-value {
    color: var(--accent);
  }

  @media (pointer: fine) {
    .channel:hover .channel-value {
      color: var(--accent);
    }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 768px) {
    .eyebrow-coords {
      display: inline;
    }

    .lede {
      font-size: var(--fs-body);
    }

    /* Desktop: name on the left, address on the right. */
    .channel {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-2) var(--space-6);
      padding-block: var(--space-6);
    }

    .channel-name {
      font-size: var(--fs-label);
    }

    .channel-value {
      font-size: var(--fs-item);
    }
  }

  /* ---------- Beside the globe (1100px and wider) ---------- */
  @media (min-width: 1100px) {
    .intro {
      padding-block: var(--space-16) var(--space-10);
    }
  }
</style>
