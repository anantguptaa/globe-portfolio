---
/**
 * BaseLayout — wraps every page: <head>, header, main content and footer.
 * A page passes its content between <BaseLayout> … </BaseLayout>; it appears at <slot />.
 *
 * Step 6: <ClientRouter /> makes navigation happen inside the page instead of a full reload,
 * and the globe lives here once, in a layer marked transition:persist, so the same Three.js
 * scene survives every page change. Each page says where the globe sits with a GlobeSlot
 * (the landing page passes its slot's pins through the `globe` prop instead).
 * The dot cursor is mounted here once too, and also kept across page changes.
 */
import { ClientRouter } from 'astro:transitions';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';

import Cursor from '../components/Cursor.astro';
import GlobeSlot from '../components/GlobeSlot.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { OG_IMAGE, SITE } from '../data/site';
import type { PagePins } from '../lib/pins';

interface Props {
  /** Page title; omit on the home page to show just the name. */
  title?: string;
  /** For search results and share previews; cut to 160 characters. Default: the site description. */
  description?: string;
  /** Ask search engines to leave this page out (the 404 page). It also gets no canonical URL. */
  noindex?: boolean;
  /** 'landing' = home page: landing header, full-screen menu, globe behind. */
  variant?: 'landing' | 'page';
  /** Coordinates of this page's pin, shown in the footer. */
  coords?: string;
  /** Hide footer social icons (Contact page). */
  showSocial?: boolean;
  /** Landing only: the globe's pins. Other pages place their own GlobeSlot. */
  globe?: PagePins;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  variant = 'page',
  coords,
  showSocial = true,
  globe,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
// Search engines show about 160 characters; cut at a word boundary with an ellipsis.
const metaDescription =
  description.length <= 160 ? description : `${description.slice(0, 157).replace(/\s+\S*$/, '')}…`;
// Absolute URLs for the canonical link and share previews. Astro.site is the `site` constant in
// astro.config.mjs. The path keeps its trailing slash, matching the sitemap.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(OG_IMAGE.path, Astro.site).href;
const isLanding = variant === 'landing';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      /* Open Graph (link previews on LinkedIn, Slack and others) and Twitter/X: the same title,
         description and share image on every page. */
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/ag-monogram.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/ag-monogram-32x32.png" />
    {
      /* Only the display font is preloaded: it sets the name and page title, the largest text
         above the fold. Inter and JetBrains Mono are smaller in impact and load from the CSS;
         preloading them too would compete with the globe's still image (the page's LCP). */
    }
    <link rel="preload" href="/fonts/TeXGyreAdventor-Bold-subset.woff2" as="font" type="font/woff2" crossorigin />
    {
      /* Marks that JavaScript is running, before anything paints. CSS uses .js to start
         mobile accordions closed without a flash; without JS everything stays open.
         ClientRouter copies the new page's <html> attributes on each navigation, which would
         drop the class, so it's put back after every swap. The flag stops a second listener
         if this script ever runs again. */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!window.__jsClassListener) {
        window.__jsClassListener = true;
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('js');
        });
      }
    </script>
    {/* In-page navigation; the default animation is a quick crossfade until step 7. */}
    <ClientRouter />
  </head>
  <body class:list={{ 'is-landing': isLanding }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      /* Landing: the globe's slot hangs off the right edge on desktop, so it sits in a
         full-page box that clips it (the page must never scroll sideways). */
      isLanding && globe && (
        <div class="landing-globe">
          <GlobeSlot variant="landing" still="landing" pins={globe.pins} active={globe.active} />
        </div>
      )
    }
    {
      /* The one live globe, kept across page changes (transition:persist). It is moved over
         the current page's GlobeSlot by site-globe.ts:
           track  = the box the slot sticks within (the whole layer when it doesn't stick),
           window = the slot's box (with its fade), stage = the square the globe is drawn in. */
    }
    <div class="globe-layer" data-globe-layer transition:persist="globe">
      <div class="globe-track" data-globe-track>
        <div class="globe-window" data-globe-window hidden>
          <div class="globe-stage" data-globe-stage></div>
        </div>
      </div>
    </div>
    <Header variant={variant} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer coords={coords} showSocial={showSocial} />
    <Cursor />

    <script>
      // Bundled, so it runs once per visit; it re-aims the globe on every page change itself.
      import '../globe/site-globe';
    </script>
  </body>
</html>

<style>
  body {
    position: relative;
  }

  /* Landing: header, menu and footer fill exactly one screen; the menu takes the leftover height. */
  .is-landing main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Landing: the menu area lets presses through to the globe behind it, except on the rows
     and other controls, so the globe can be dragged where the rows don't cover it. */
  .is-landing main {
    pointer-events: none;
  }

  .is-landing main :global(a),
  .is-landing main :global(button) {
    pointer-events: auto;
  }

  /* Header, main and footer sit above the globe on every page. They're rendered by child
     components, so :global() is needed to reach them from this file's scoped styles. */
  body > :global(header),
  body > main,
  body > :global(footer) {
    position: relative;
    z-index: 1;
  }

  /* Landing slot's clip box: full page, clips the slot's overflow, lets presses through. */
  .landing-globe {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* The live globe's layer: full page, behind the content, clips anything that hangs off
     the edge. Nothing in it takes presses: dragging is handled on the page's slot.
     overflow: clip, not hidden: hidden would make the layer a scroll container, and the
     sticky globe window inside would then stick to the layer instead of the screen. */
  .globe-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    pointer-events: none;
  }

  /* Pages with a sticky globe (GlobePage): the content scrolls UNDER the globe strip, so the
     globe goes above the content. The header stays on top of both. */
  body:has([data-globe-page]) .globe-layer {
    z-index: 2;
  }

  body:has([data-globe-page]) > :global(header) {
    z-index: 3;
  }

  /* Position and size of all three are set by site-globe.ts to match the page's slot. The
     window is position: sticky when the slot is (set inline); otherwise absolute. */
  .globe-track,
  .globe-window,
  .globe-stage {
    position: absolute;
  }

  .globe-window[hidden] {
    display: none;
  }

  /* The canvas fades in over the still once the globe is ready (data-globe on <html>);
     the still fades out at the same time (GlobeSlot.astro). */
  .globe-stage :global(canvas) {
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-settle);
  }

  :global(html[data-globe='live']) .globe-stage :global(canvas) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-stage :global(canvas) {
      transition-duration: var(--dur-fast);
    }
  }

  /* ---------- Page transitions (src/globe/transitions.ts) ----------
     <html data-nav="zoom|move|glide|crossfade" data-phase="out|in"> during a navigation;
     "out" before the swap, "in" after it. */

  /* Zoom, before the swap: the whole landing page fades out and stops taking clicks. */
  :global(html[data-nav='zoom'][data-phase='out']) body > :global(header),
  :global(html[data-nav='zoom'][data-phase='out']) body > main,
  :global(html[data-nav='zoom'][data-phase='out']) body > :global(footer),
  :global(html[data-nav='zoom'][data-phase='out']) .landing-globe {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fade-out) linear;
  }

  /* Zoom, after the swap: the new page's content fades in while the globe settles. */
  :global(html[data-nav='zoom'][data-phase='in']) body > :global(header),
  :global(html[data-nav='zoom'][data-phase='in']) body > main,
  :global(html[data-nav='zoom'][data-phase='in']) body > :global(footer) {
    animation: nav-fade-in var(--dur-fade-in) var(--ease-settle) both;
  }

  /* Page → page: new content fades in after a short delay. The header is the same on every
     inner page, so it doesn't fade; only its "current" link changes. */
  :global(html[data-nav='move'][data-phase='in']) body > main,
  :global(html[data-nav='move'][data-phase='in']) body > :global(footer) {
    animation: nav-fade-in var(--dur-fade-in) var(--ease-settle) var(--delay-fade-in) both;
  }

  /* Page → landing: the landing page (header, menu, footer) fades in as the globe glides. */
  :global(html[data-nav='glide'][data-phase='in']) body > :global(header),
  :global(html[data-nav='glide'][data-phase='in']) body > main,
  :global(html[data-nav='glide'][data-phase='in']) body > :global(footer) {
    animation: nav-fade-in var(--dur-landing-in) var(--ease-settle) both;
  }

  /* The pin label would be carried around with the moving globe: hide it until it's over. */
  :global(html[data-nav]) .globe-stage :global(.globe-label) {
    visibility: hidden;
  }
</style>

{
  /* Not scoped: view-transition pseudo-elements and their keyframes belong to the document.
     The browser shows the old page as a snapshot on top of the live new page during a
     transition. Here the snapshot fades out on top (old content fades away) while the live
     page underneath does its own fades (above), so the globe, which is part of the live page,
     stays visible and in its place throughout. */
}
<style is:global>
  @keyframes nav-fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes nav-fade-out {
    to {
      opacity: 0;
    }
  }

  /* Zoom: the old page has already faded out before the swap; swap instantly underneath. */
  html[data-nav='zoom']::view-transition-old(root),
  html[data-nav='zoom']::view-transition-new(root) {
    animation: none;
  }

  /* Move and glide: the old page's snapshot fades out on top of the live new page. */
  html[data-nav='move']::view-transition-old(root),
  html[data-nav='glide']::view-transition-old(root) {
    z-index: 1;
    animation: nav-fade-out var(--dur-fade-out) linear both;
  }

  html[data-nav='move']::view-transition-new(root),
  html[data-nav='glide']::view-transition-new(root) {
    animation: none;
  }

  /* The header word flying into the title (only the clicked word and the new title are named). */
  html[data-nav='move']::view-transition-group(*) {
    animation-duration: var(--dur-word);
    animation-timing-function: var(--ease-move);
  }

  /* The dot cursor has its own layer: no old copy, no animation; it just stays on the pointer. */
  ::view-transition-old(cursor) {
    display: none;
  }

  ::view-transition-group(cursor),
  ::view-transition-new(cursor) {
    animation: none;
  }

  /* Reduced motion and low-end devices: a plain, short crossfade. !important so it also wins
     over any reduced-motion rule that turns view-transition animations off entirely. */
  html[data-nav='crossfade']::view-transition-old(root) {
    z-index: 1;
    animation: nav-fade-out var(--dur-crossfade) linear both !important;
  }

  html[data-nav='crossfade']::view-transition-new(root) {
    animation: none !important;
  }
</style>
